Options -Indexes -ExecCGI

<FilesMatch "(?i)^(?!.*\.(jpe?g|png|gif|webp|pdf|docx?|txt)$)">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(jpe?g|png|gif|webp|pdf|docx?|txt)$">
    SetHandler default-handler
</FilesMatch>

<FilesMatch "(?i)\.(php[0-9]*|phtml|pht|phar|cgi|pl|py|sh|asp|aspx|jsp|shtml|html?|svg|htaccess|user\.ini)(\.|$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
